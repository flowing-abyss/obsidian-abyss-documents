{
  "name": "abyss-documents",
  "version": "0.1.0",
  "private": true,
  "description": "A native document reading interface for PDF files in Obsidian.",
  "author": "flowing-abyss",
  "funding": "https://boosty.to/flowing-abyss/donate",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "build:analyze": "pnpm typecheck && node esbuild.config.mjs production analyze",
    "build:styles": "node scripts/build-styles.mjs",
    "check:styles": "node scripts/build-styles.mjs --check",
    "preversion": "pnpm run verify && node release-check.mjs --release-ready && pnpm run test:e2e",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push --follow-tags",
    "release": "pnpm version --tag-version-prefix ''",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint '**/*.css' --max-warnings 0",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --testTimeout=10000",
    "dev:vault": "pnpm run build && tsx scripts/generate-dev-vault.mts",
    "test:e2e": "tsx scripts/run-e2e.mts",
    "test:e2e:reader": "pnpm dev:vault -- --no-launch && wdio run tests/e2e/wdio.conf.mts --spec tests/e2e/reader.e2e.ts",
    "test:e2e:android": "pnpm dev:vault -- --no-launch && wdio run tests/e2e/wdio.mobile.conf.mts",
    "test:package": "pnpm run build && tsx scripts/smoke-community-package.mts",
    "benchmark:reader": "pnpm dev:vault -- --no-launch && tsx scripts/benchmark-reader.mts",
    "benchmark:annotations": "tsx scripts/benchmark-annotations.mts",
    "benchmark:annotations:android": "tsx scripts/benchmark-annotations.mts --platform=android",
    "deadcode": "knip",
    "arch": "depcruise src --config dependency-cruiser.config.cjs --output-type err-long",
    "release:check": "node release-check.mjs",
    "verify:task": "pnpm lint && pnpm typecheck && pnpm test",
    "test:ai": "node --test \".ai/**/*.test.mjs\"",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm check:styles && pnpm typecheck && pnpm typecheck:e2e && pnpm arch && pnpm deadcode && pnpm test:ai && pnpm test:coverage && pnpm build && pnpm release:check",
    "ci": "pnpm verify",
    "prepare": "husky && node .ai/setup.mjs && node .ai/setup-codegraph.mjs",
    "codegraph:setup": "node .ai/setup-codegraph.mjs"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "release": {
    "mainJsBudgetBytes": 2097152
  },
  "keywords": [],
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/mocha": "10.0.10",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@wdio/appium-service": "9.32.0",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "appium": "3.8.0",
    "appium-uiautomator2-driver": "8.7.0",
    "dependency-cruiser": "^18.7.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "expect-webdriverio": "6.1.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "mocha": "10.8.2",
    "obsidian": "1.14.4",
    "obsidian-test-mocks": "^7.2.3",
    "pdf-lib": "1.17.1",
    "postcss": "8.5.31",
    "postcss-prefix-selector": "2.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "puppeteer-core": "24.43.1",
    "stylelint": "^17.16.0",
    "stylelint-config-obsidianmd": "0.1.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wdio-obsidian-reporter": "3.3.0",
    "wdio-obsidian-service": "3.3.0",
    "webdriverio": "9.32.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pdfjs-dist": "6.4.299"
  }
}
