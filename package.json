{
  "name": "abyss-documents",
  "version": "0.1.0",
  "private": true,
  "description": "A native document reading interface for PDF files in Obsidian.",
  "author": "flowing-abyss",
  "funding": "https://boosty.to/flowing-abyss/donate",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "build:analyze": "pnpm typecheck && node esbuild.config.mjs production analyze",
    "build:styles": "node scripts/build-styles.mjs",
    "check:styles": "node scripts/build-styles.mjs --check",
    "preversion": "pnpm run verify && node release-check.mjs --release-ready && pnpm run test:e2e",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push --follow-tags",
    "release": "pnpm version --tag-version-prefix ''",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint '**/*.css'",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:vault": "pnpm run build && tsx scripts/generate-dev-vault.mts",
    "test:e2e": "pnpm dev:vault -- --no-launch && wdio run tests/e2e/wdio.conf.mts",
    "test:e2e:reader": "pnpm dev:vault -- --no-launch && wdio run tests/e2e/wdio.conf.mts --spec tests/e2e/reader.e2e.ts",
    "test:e2e:android": "pnpm dev:vault -- --no-launch && wdio run tests/e2e/wdio.mobile.conf.mts",
    "test:package": "pnpm run build && tsx scripts/smoke-community-package.mts",
    "benchmark:reader": "pnpm dev:vault -- --no-launch && tsx scripts/benchmark-reader.mts",
    "deadcode": "knip",
    "arch": "depcruise src --config dependency-cruiser.config.cjs --output-type err-long",
    "release:check": "node release-check.mjs",
    "verify:task": "pnpm lint && pnpm typecheck && pnpm test",
    "test:ai": "node --test \".ai/**/*.test.mjs\"",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm check:styles && pnpm typecheck && pnpm typecheck:e2e && pnpm arch && pnpm deadcode && pnpm test:ai && pnpm test:coverage && pnpm build && pnpm release:check",
    "ci": "pnpm verify",
    "prepare": "husky && node .ai/setup.mjs"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "release": {
    "mainJsBudgetBytes": 2097152
  },
  "keywords": [],
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@types/mocha": "10.0.10",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/appium-service": "9.30.0",
    "@wdio/cli": "9.30.0",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.0",
    "@wdio/mocha-framework": "9.30.0",
    "appium": "3.6.0",
    "appium-uiautomator2-driver": "8.2.2",
    "dependency-cruiser": "^18.1.0",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "expect-webdriverio": "5.7.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "mocha": "10.8.2",
    "obsidian": "latest",
    "obsidian-test-mocks": "^3.9.0",
    "pdf-lib": "1.17.1",
    "postcss": "8.5.26",
    "postcss-prefix-selector": "2.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "puppeteer-core": "24.43.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10",
    "wdio-obsidian-reporter": "3.1.1",
    "wdio-obsidian-service": "3.1.1",
    "webdriverio": "9.30.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pdfjs-dist": "6.2.108"
  }
}
